+
+bool MpActor::ApplyCombatProfile(aetherius::combat::CombatProfile profile)
+{
+  // Prepare serialization before publishing: failed validation/allocation cannot
+  // leave a half-updated profile. Native API already validates catalog and ranks.
+  if (profile.revision <= pImpl->combatState.profile.revision) return false;
+  auto dump = profile.ToJson().dump();
+  EditChangeForm([&](MpChangeForm& changeForm) {
+    changeForm.combatProfileDump = std::move(dump);
+  });
+  pImpl->combatState.Apply(std::move(profile));
+  return true;
+}
