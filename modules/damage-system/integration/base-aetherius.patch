+namespace {
+uint32_t CombatActorId(const Napi::CallbackInfo& info)
+{
+  if (info.Length() < 1 || !info[0].IsNumber()) throw std::invalid_argument("actorId must be numeric");
+  const auto id = info[0].As<Napi::Number>().DoubleValue();
+  if (!std::isfinite(id) || id < 1 || id > 4294967295.0 || std::floor(id) != id)
+    throw std::invalid_argument("invalid actorId");
+  return static_cast<uint32_t>(id);
+}
+}
+
+Napi::Value ScampServer::ApplyActorCombatProfile(const Napi::CallbackInfo& info)
+{
+  try {
+    auto id = CombatActorId(info);
+    if (!partOne->worldState.aetheriusCombatEnabled) throw std::runtime_error("Aetherius combat is disabled");
+    if (info.Length() != 2 || !info[1].IsString()) throw std::invalid_argument("profileJson must be string");
+    auto text = info[1].As<Napi::String>().Utf8Value();
+    if (text.size() > 65536) throw std::invalid_argument("combat profile exceeds 64 KiB");
+    auto profile = aetherius::combat::CombatProfile::FromJson(nlohmann::json::parse(text));
+    combatPerks.Validate(profile);
+    auto& actor = partOne->worldState.GetFormAt<MpActor>(id);
+    if (!actor.ApplyCombatProfile(std::move(profile))) throw std::invalid_argument("stale combat profile revision");
+    return info.Env().Undefined();
+  } catch (const std::exception& e) { throw Napi::Error::New(info.Env(), e.what()); }
+}
+
+Napi::Value ScampServer::GetActorCombatProfile(const Napi::CallbackInfo& info)
+{
+  try {
+    auto& actor = partOne->worldState.GetFormAt<MpActor>(CombatActorId(info));
+    return Napi::String::New(info.Env(), actor.GetCombatState().profile.ToJson().dump());
+  } catch (const std::exception& e) { throw Napi::Error::New(info.Env(), e.what()); }
+}
