{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherius.local/schemas/enemy-level-scaling.schema.json",
  "type": "object",
  "required": ["schemaVersion", "balanceVersion", "ranges"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "balanceVersion": { "type": "string", "minLength": 1 },
    "ranges": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["levelFrom", "levelTo", "status", "formula", "provenance"], "additionalProperties": false, "properties": { "levelFrom": { "type": "integer", "minimum": 1, "maximum": 100 }, "levelTo": { "type": "integer", "minimum": 1, "maximum": 100 }, "status": { "enum": ["ASSIGNED", "UNRESOLVED"] }, "formula": { "anyOf": [{ "type": "null" }, { "type": "object", "required": ["kind", "base", "levelOffset", "slope"], "additionalProperties": false, "properties": { "kind": { "const": "AFFINE" }, "base": { "type": "number", "exclusiveMinimum": 0 }, "levelOffset": { "type": "number" }, "slope": { "type": "number", "minimum": 0 } } }] }, "provenance": { "type": "string", "minLength": 1 } } } }
  }
}
