{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherius.local/schemas/content-relevance.schema.json",
  "type": "object",
  "required": ["schemaVersion", "balanceVersion", "status", "policy", "inputs", "provenance", "bossFixedXpEffect"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "balanceVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["UNRESOLVED", "ASSIGNED"] },
    "policy": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["kind", "belowRangeMultiplier", "withinRangeMultiplier", "reductionPerLevelAboveMax", "maximumReduction"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "LINEAR_REDUCTION_ABOVE_MAX" },
            "belowRangeMultiplier": { "type": "number", "minimum": 0, "maximum": 1 },
            "withinRangeMultiplier": { "type": "number", "minimum": 0, "maximum": 1 },
            "reductionPerLevelAboveMax": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "maximumReduction": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 }
          }
        }
      ]
    },
    "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "provenance": { "type": "string", "minLength": 1 },
    "bossFixedXpEffect": { "enum": ["UNRESOLVED", "APPLIES", "BYPASSES"] }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "UNRESOLVED" } } }, "then": { "properties": { "policy": { "type": "null" } } } },
    { "if": { "properties": { "status": { "const": "ASSIGNED" } } }, "then": { "properties": { "policy": { "type": "object" } } } }
  ]
}
